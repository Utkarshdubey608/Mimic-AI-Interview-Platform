# Production build config. Vite ranks .env.production above .env, so this is
# what a `npm run build` bakes into the bundle.
#
# Every value here is PUBLIC by design — it ships inside the browser bundle
# either way. The Firebase web config is not a secret (security comes from
# Firestore rules and Auth, not from hiding it), and VITE_API_BASE is just a
# URL. They are listed in full rather than inherited from .env because .env is
# gitignored: a teammate or CI job cloning this repo would otherwise build a
# bundle with no Firebase config and hit an auth failure with nothing
# explaining why.
#
# Server-side secrets (GEMINI_API_KEY, DEEPGRAM_API_KEY, …) must NEVER appear
# here. Anything VITE_-prefixed is readable by every visitor. VITE_GEMINI_KEY in
# particular is deliberately absent.

# The deployed backend's ORIGIN — no path, no trailing slash.
# apiOrigin.ts appends /api/web (web surface) and /api (common) itself.
VITE_API_BASE=https://inteview-backend-14029160874.asia-south1.run.app

VITE_FIREBASE_API_KEY=AIzaSyAF1O1SoXKv5iZ1RMaXQurVYwRSoT4ynqY
VITE_FIREBASE_AUTH_DOMAIN=talbotiq-9cc4e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talbotiq-9cc4e
VITE_FIREBASE_STORAGE_BUCKET=talbotiq-9cc4e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=473028554722
VITE_FIREBASE_APP_ID=1:473028554722:web:152baa837fe77c7fb713bb
