rules_version = '2';

// TalbotIQ Firestore security rules.
//
// Model:
//   users/{uid}          — one doc per account, holds { email, role, name }
//   interviews/{id}      — a recruiter-created interview assigned to a candidate
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The signed-in user's role, read from their users doc.
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isRecruiter() {
      return isSignedIn() && myRole() == 'recruiter';
    }

    // The auth token's email, normalized for candidate-assignment matching.
    function myEmailLower() {
      return request.auth.token.email.lower();
    }

    // True when an update leaves `field` exactly as it was, INCLUDING the case
    // where it is absent on both sides.
    //
    // The absence check is not decoration: `roundId` is written only for tests
    // that use a timeline, so it is missing from every interview created before
    // rounds existed. Comparing a missing key directly would fail the rule and
    // lock those candidates out of interviews they are legitimately assigned.
    function unchanged(field) {
      return (field in resource.data) == (field in request.resource.data)
             && (!(field in resource.data)
                 || resource.data[field] == request.resource.data[field]);
    }

    // users: a user may read/write only their own profile doc.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      // Once a role has been recorded it is immutable via self-update, so a
      // candidate account can't silently self-promote to recruiter (isRecruiter()
      // trusts this field). Role provisioning/changes must go through an admin
      // path (server/Cloud Function), not a client write.
      allow update: if isSignedIn() && request.auth.uid == uid
                    && (!('role' in resource.data)
                        || request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    // practice_sessions: a candidate's OWN self-serve rehearsal history.
    //
    // Written by the client, unlike an interview score, and that is deliberate rather
    // than an oversight: practice is self-serve, nothing gates on it, and no recruiter
    // ever reads it. An assigned interview's score is the opposite on all three counts,
    // which is why `interviews` forbids a candidate writing `result` and the server
    // writes it with the Admin SDK instead.
    //
    // Nested under the uid so the rule is ONE comparison rather than a field check on
    // every document — and so there is no shape of query that returns somebody else's
    // history, which a top-level collection with a `uid` field would allow if a filter
    // were ever dropped.
    match /practice_sessions/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      match /runs/{runId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // mcq_sets / mcq_attempts: SERVER-WRITTEN ONLY. No client may read or write
    // either one, and both are listed explicitly rather than left to the default
    // deny — because the reason is not obvious and the next person to add a rule
    // needs to see it stated.
    //
    // `mcq_sets` is a recruiter's assessment paper, and a paper CONTAINS THE
    // ANSWER KEY. A candidate who could read the collection would not need to sit
    // the test. Recruiters author papers through `/api/mcq-sets`, which filters on
    // a `recruiterId` stamped server-side from the auth token — never from the
    // client — so ownership is enforced where it can be trusted rather than by a
    // rule reading a field the writer controls.
    //
    // `mcq_attempts` is a candidate's answers, and unlike `practice_sessions` next
    // door it DECIDES A SCORE. Practice is self-serve and nothing gates on it,
    // which is why the client writes it directly; an attempt is the input to a
    // grade, so the candidate being graded must not be able to write it. Answers
    // go through POST /api/interviews/{id}/mcq/answers and are scored with the
    // Admin SDK, which bypasses these rules.
    match /mcq_sets/{setId} {
      allow read, write: if false;
    }

    match /mcq_attempts/{interviewId} {
      allow read, write: if false;
    }

    // tests: per-batch metadata (title/type/createdAt) for the recruiter
    // dashboard's test list. Owned solely by the recruiter who created it;
    // candidates never read it (they only ever see their own interview doc).
    match /tests/{testId} {
      allow read: if isRecruiter()
                     && resource.data.recruiterId == request.auth.uid;
      allow create, update: if isRecruiter()
                     && request.resource.data.recruiterId == request.auth.uid;
      allow delete: if isRecruiter()
                     && resource.data.recruiterId == request.auth.uid;

      // rounds: the test's custom timeline — one document per stage, each with
      // its own open/close window (see interview_round.dart).
      //
      // Recruiter-only, exactly like the parent test. A candidate never reads
      // these: everything their device needs (the round's kind, its order, and
      // its window) is COPIED onto their own interview document at assignment
      // time, so the timeline stays private to the recruiter who designed it.
      //
      // Authorisation is on the round's OWN recruiterId rather than a get() of
      // the parent test: a get() inside a rule is a billed read, and this rule
      // runs once per round document returned by the timeline query.
      match /rounds/{roundId} {
        allow read: if isRecruiter()
                       && resource.data.recruiterId == request.auth.uid;
        allow create, update: if isRecruiter()
                       && request.resource.data.recruiterId == request.auth.uid;
        allow delete: if isRecruiter()
                       && resource.data.recruiterId == request.auth.uid;
      }
    }

    // roleConfigs: reusable per-role interview pipeline templates (Feature 1).
    // SHARED, top-level like `tests` — a pipeline authored on the web must be
    // usable from a mobile spreadsheet import, and vice versa. Owner-only, same
    // pattern as `tests` above: a candidate never reads these, and a template
    // has no lifecycle of its own to gate on.
    match /roleConfigs/{configId} {
      allow read: if isRecruiter()
                     && resource.data.recruiterId == request.auth.uid;
      allow create, update: if isRecruiter()
                     && request.resource.data.recruiterId == request.auth.uid;
      allow delete: if isRecruiter()
                     && resource.data.recruiterId == request.auth.uid;
    }

    // interviews:
    //   - recruiters manage the interviews they created
    //   - candidates may read + update (status/result) interviews assigned to
    //     their email; they cannot create or delete
    match /interviews/{id} {
      allow read: if isRecruiter()
                     && resource.data.recruiterId == request.auth.uid
                  || (isSignedIn()
                     && resource.data.candidateEmailLower == myEmailLower());

      allow create: if isRecruiter()
                     && request.resource.data.recruiterId == request.auth.uid;

      // Recruiter (owner) may change anything, incl. publishing results.
      // Candidate (assignee) may write their submission/status/attempts but must
      // NOT flip resultPublished — only the recruiter releases results.
      allow update: if (isRecruiter()
                        && resource.data.recruiterId == request.auth.uid)
                    || (isSignedIn()
                        && resource.data.candidateEmailLower == myEmailLower()
                        && request.resource.data.resultPublished
                           == resource.data.resultPublished
                        // Candidate must not re-assign the interview to another
                        // recruiter/candidate, or move it between tests/rounds.
                        && request.resource.data.recruiterId
                           == resource.data.recruiterId
                        && request.resource.data.candidateEmailLower
                           == resource.data.candidateEmailLower
                        && request.resource.data.testId == resource.data.testId
                        && unchanged('roundId')
                        // The access window and attempt cap are the ONLY things
                        // stopping a candidate taking a closed round, and
                        // "end round now" works by stamping expiresAt onto this
                        // document. A candidate who could rewrite these fields
                        // could re-open a round the recruiter had ended, so they
                        // are recruiter-only. (attemptsUsed is NOT here — the
                        // client increments it on launch.)
                        && unchanged('availableFrom')
                        && unchanged('expiresAt')
                        && unchanged('maxAttempts')
                        // `resume` (the extracted text and its AI score) is
                        // written ONLY by the backend, with the Admin SDK, which
                        // bypasses these rules. A résumé score decides whether
                        // someone progresses, so the candidate being scored must
                        // not be able to write it. `result` cannot be locked the
                        // same way — a candidate legitimately writes it when they
                        // finish an interview round — which is exactly why the
                        // résumé path was moved server-side instead.
                        && unchanged('resume')
                        // `conclusion` is the recruiter's decision about the
                        // candidate's whole run at the test, plus the message
                        // they wrote them. Unlike `result`, a candidate never
                        // legitimately writes it — nothing on their device
                        // produces one — so it is locked the same way `resume`
                        // is, rather than being left writable and trusted.
                        && unchanged('conclusion'));

      allow delete: if isRecruiter()
                     && resource.data.recruiterId == request.auth.uid;
    }
  }
}
