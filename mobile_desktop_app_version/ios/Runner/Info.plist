<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>TalbotIQ needs camera access so the AI interviewer can see you during the video interview.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TalbotIQ needs microphone access so the AI interviewer can hear your answers during the interview.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>TalbotIQ uses speech recognition to transcribe your interview answers for the results report.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Mimic</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Mimic</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Deep linking: custom URL scheme. Handles candidate invite links of the
	     form  talbotiq://interview/<interviewId>. This works purely client-side
	     with no server configuration.
	     TODO(deploy): HTTPS Universal Links (https://<domain>/take/<id>) are NOT
	     configured here. They additionally require an "Associated Domains"
	     entitlement (applinks:<domain>) in Runner.entitlements and an
	     apple-app-site-association file hosted at
	     https://<domain>/.well-known/apple-app-site-association on the real
	     deployed domain. Only the custom scheme below is scaffolded because it
	     needs no server. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.talbotiq.app.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>talbotiq</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
