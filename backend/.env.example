# Copy to .env and fill in. Safe dev defaults everywhere except credentials.

# --- App ---
APP_NAME=TalbotIQ Mailer
CORS_ORIGINS=*

# --- Auth ---
# Shared secret the Flutter app sends as X-API-Key. Empty = auth DISABLED (dev).
API_KEY=

# --- Delivery ---
# true = log instead of send (no credentials needed). Set false to send for real.
DRY_RUN=true
FROM_NAME=TalbotIQ

# DEPLOYMENT uses the shared TalbotIQ Office 365 mailbox for BOTH surfaces:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587                            # STARTTLS
#   SMTP_USER=team@talbotiq.com
#   SMTP_PASS=<the mailbox password>
#   MAIL_FROM=TalbotIQ <team@talbotiq.com>
# Office 365 enforces Send As against the From: header, so a per-send `from_override`
# only works for addresses this mailbox holds Send As rights for. Otherwise leave the
# sender alone and use Reply-To.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# Mode A (legacy): a Gmail App Password from myaccount.google.com/apppasswords
# (requires 2-Step Verification). 16 characters; spaces are fine. Only consulted when
# SMTP_USER / SMTP_PASS below are blank.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Generic SMTP — needed for any relay where the LOGIN differs from the SENDER, and
# the normal path now. Brevo was the case that forced it: you authenticate as
# "…@smtp-brevo.com" but must send From your own verified domain, which Gmail's
# one-address model cannot express.
# The web invite flow also needs a per-send sender, a reply-to, and the
# X-Mailin-custom header that lets Brevo's delivery webhooks be traced back to a
# recipient.
#
# All three fall back to the Gmail values above when blank, so an existing
# EMAIL_USER + EMAIL_APP_PASSWORD deployment keeps working unchanged. Set them for
# Brevo, if you ever go back to it:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_USER=<your Brevo SMTP login, …@smtp-brevo.com>
#   SMTP_PASS=<your Brevo SMTP key, xsmtpsib-…>
#   MAIL_FROM=TalbotIQ <talent@yourco.com>   # must be VERIFIED in Brevo
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Mode B (optional): Gmail API via OAuth refresh token. Used instead of SMTP
# when all three are set — handy where outbound SMTP is blocked.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Recipients delivered in parallel within one /send call.
SEND_CONCURRENCY=5

# --- Third-party AI providers ---
# These live ONLY here. The mobile app never receives them: it calls a proxy
# route on this service, or connects to Gemini Live with a short-lived token
# minted from GEMINI_API_KEY. Leave one blank and that feature reports 503
# instead of failing with a confusing vendor error.
#
# Gemini: an AI Studio key from https://aistudio.google.com/apikey — it starts
# with "AIza". Newer "AQ."-prefixed Cloud keys are rejected by
# generativelanguage.googleapis.com and will NOT work.
GEMINI_API_KEY=
TAVUS_API_KEY=
DEEPGRAM_API_KEY=

# Daily — the live recruiter<->candidate call (the two-way interview track).
# An API key from dashboard.daily.co -> Developers. The free tier is enough:
# the call is not recorded, so no paid cloud-recording feature is used.
# The device only ever receives a room URL and a short-lived meeting token.
DAILY_API_KEY=
# Your Daily subdomain, WITHOUT the scheme — e.g. talbotiq.daily.co.
# Required whenever DAILY_API_KEY is set: the recruiter's room URL comes back
# from Daily when the room is created, but the CANDIDATE's is built from this.
# Leave it blank with a key set and the recruiter can start a call the candidate
# cannot join.
DAILY_DOMAIN=

# LiveKit — the ALTERNATIVE two-way engine (self-hosted, records the call so the
# round gets a transcript + auto-scorecard). Set TWOWAY_ENGINE=livekit to use it;
# "daily" (default) ignores everything below. Needs the LiveKit server + egress
# + Redis deployed, and an S3-compatible bucket for recordings (GCS/S3/MinIO).
#
# This applies to BOTH clients — the web surface (`/api/web/sessions/*`) and the
# app one (`/api/interviews/*`) read the same switch, so the website and the
# Flutter app always land in the same room on the same media server. Recording
# and auto-scoring are still web-only: the egress webhook resolves a room to a
# web session, and app interviews are Firestore `interviews` documents.
TWOWAY_ENGINE=daily
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Recording storage. LK_S3_ENDPOINT is what the egress workers write to; the
# backend fetches finished files from LK_S3_PUBLIC_ENDPOINT (use 127.0.0.1 rather
# than localhost locally to avoid an IPv6 resolution stall).
LK_S3_ENDPOINT=
LK_S3_PUBLIC_ENDPOINT=
LK_S3_BUCKET=
LK_S3_KEY=
LK_S3_SECRET=
LK_S3_REGION=us-east-1

# Scoring / question generation (REST generateContent).
#
# `gemini-2.5-flash`/`-pro` are retired from generateContent for new API keys —
# a key that authenticates fine still 404s on every call ("no longer available
# to new users... use gemini-3.6-flash") until this is updated.
GEMINI_MODEL=gemini-3.6-flash
# Models a caller may ask for instead of the default. An ALLOWLIST, not free
# choice: recruiters legitimately pick between flash and pro, but a client must
# not be able to redirect spend onto an arbitrarily expensive model. Anything
# unrecognised silently falls back to GEMINI_MODEL.
GEMINI_ALLOWED_MODELS=gemini-3.6-flash,gemini-3.1-pro-preview
# Native-audio model for the live voice interview.
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-09-2025

# --- Gemini Live ephemeral tokens ---
# Grace added to an interview's own duration before the session is cut off.
GEMINI_TOKEN_EXPIRY_BUFFER_MINUTES=10
# How long the client has to OPEN the session after minting (Google default 60s).
GEMINI_TOKEN_CONNECT_WINDOW_SECONDS=120
# A voice PREVIEW is one short spoken line, so it needs no interview-length
# session. A tight cap bounds what a misused preview token can cost.
GEMINI_PREVIEW_SESSION_MINUTES=2

# --- Tavus conversation defaults ---
# Org infrastructure, applied when the backend creates a conversation. These were
# text fields in the app's Settings (an AWS assume-role ARN, typed on a phone) and
# are server-side for the same reason the API keys are. A client cannot override
# any of the recording fields — see _LOCKED_PROPERTIES in app/providers/tavus.py.
TAVUS_ENABLE_RECORDING=false
TAVUS_RECORDING_S3_BUCKET=
TAVUS_RECORDING_S3_REGION=
TAVUS_AWS_ASSUME_ROLE_ARN=
# Session properties the app used to expose globally. Per-interview values
# (duration, language) still come from the interview itself.
TAVUS_PARTICIPANT_LEFT_TIMEOUT=60
TAVUS_PARTICIPANT_ABSENT_TIMEOUT=300
TAVUS_ENABLE_TRANSCRIPTION=true

# --- Rate limiting (per user, per worker) ---
# Auth proves the caller is a real user; these bound what one user can spend.
# Counters are in-process: they reset on restart and are NOT shared between
# workers, so N workers allow roughly N x these numbers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LIVE_TOKEN=10
RATE_LIMIT_GENERATE=30
RATE_LIMIT_MEDIA=20
# Web surface only. Facial-analysis frames: the browser captures one every 8
# seconds (~7.5/min per candidate), so this is 8x real use — high enough never to
# interrupt an interview, low enough to stop a hot loop.
RATE_LIMIT_FACE=60
# Web surface only. Mimic Guide chat + its text-to-speech.
RATE_LIMIT_CHAT=30
# When the counters above become EXACT (i.e. _LIMITER in app/ratelimit.py is
# swapped for a shared store), raise LIVE_TOKEN/GENERATE/MEDIA to 20/90/60 in the
# same change. Today N workers allow roughly N x each number, so making them exact
# without raising them would start throttling callers that pass right now.

# --- Firebase (same project as the mobile app) ---
# REQUIRED, not optional. Every AI route verifies a Firebase ID token, so without
# credentials here those routes answer 503. The Admin SDK also WRITES with them:
# resume scores, interview evaluations and the end of a two-way call are all
# stored server-side precisely because firestore.rules lets a candidate update
# their own interview document, so a score the app wrote would be a score the
# candidate chose.
FIREBASE_PROJECT_ID=talbotiq-9cc4e
# Service-account JSON: either a path...
FIREBASE_CREDENTIALS_FILE=./serviceAccount.json
# ...or the JSON inline (one env var, handy on Render / Cloud Run).
FIREBASE_CREDENTIALS_JSON=
TEMPLATES_COLLECTION=email_templates
